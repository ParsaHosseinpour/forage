# Copy this file to .env.local (git-ignored) to override the defaults in .env.
# Variables set in your host's environment (for example Vercel) win over both.

# ── Supabase (required) ─────────────────────────────────────────────────────
# Project Settings → API. Use the anon (public) key, NEVER the service-role key.
# The committed .env already points at the original project.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Affiliate / grocery ordering integration (optional) ─────────────────────
# Comma-separated list of platforms to show, in display order.
# Supported: instacart, amazon, walmart, google_shopping
# Defaults to "instacart,amazon" if unset.
VITE_AFFILIATE_PLATFORMS=instacart,amazon

# Per-platform tracking/affiliate IDs (all optional — links still work
# without them, just unattributed).
VITE_INSTACART_AFFILIATE_ID=your_instacart_partner_id_here
VITE_AMAZON_AFFILIATE_TAG=your_amazon_associates_tag_here
VITE_WALMART_AFFILIATE_ID=your_walmart_affiliate_id_here

# Seed scripts (scripts/*) read the project URL from SUPABASE_URL, VITE_SUPABASE_URL
# or the repo's .env, and take the service-role key from SUPABASE_SERVICE_KEY in
# your shell only. Never put the service-role key in any file.
