# Forage — Environment Variables
# No external API keys are required. All recipe data is served from Supabase.
# Seed the database once with: node scripts/seed-mealdb.js

# Affiliate / grocery ordering integration (optional)
# Platform: "instacart" | "amazon_fresh" | "walmart" | "google_shopping"
# Defaults to instacart + forage_app partner ID if unset.
VITE_AFFILIATE_PLATFORM=instacart
VITE_AFFILIATE_ID=your_affiliate_partner_id_here
