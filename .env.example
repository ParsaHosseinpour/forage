# Forage — Environment Variables
# No external API keys are required. All recipe data is served from Supabase.
# Seed the database once with: node scripts/seed-mealdb.js

# ── Affiliate / grocery ordering integration (optional) ─────────────────────
# Comma-separated list of platforms to show, in display order.
# Supported: instacart, amazon, walmart, google_shopping
# Defaults to "instacart,amazon" if unset.
VITE_AFFILIATE_PLATFORMS=instacart,amazon

# Per-platform tracking/affiliate IDs (all optional — links still work
# without them, just unattributed).
VITE_INSTACART_AFFILIATE_ID=your_instacart_partner_id_here
VITE_AMAZON_AFFILIATE_TAG=your_amazon_associates_tag_here
VITE_WALMART_AFFILIATE_ID=your_walmart_affiliate_id_here
